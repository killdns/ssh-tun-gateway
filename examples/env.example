RUN_MODE=gateway

SSH_HOST=203.0.113.10
SSH_ROUTE_IP=203.0.113.10
SSH_USER=ssh-tunnel-1
SSH_PORT=22
IDENTITY_FILE=/config/id_ed25519
KNOWN_HOSTS_FILE=/config/known_hosts
STRICT_HOST_KEY_CHECKING=yes

# Must match the gateway in compose.yaml.
CONTAINER_GATEWAY=172.30.255.1
# Networks that need return routes through the original container gateway.
LAN_CIDRS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

LOCAL_TUN_ID=0
REMOTE_TUN_ID=0
TUN_LOCAL=10.255.255.2
TUN_REMOTE=10.255.255.1
TUN_MTU=1400
ENABLE_NAT=1

SOCKS_BIND=0.0.0.0
SOCKS_PORT=1080
SOCKS_USER=
SOCKS_PASSWORD=
SOCKS_ALLOW_NO_AUTH=1
SOCKS_DNS_SERVER=1.1.1.1
SOCKS_WORKERS=2
SOCKS_UDP_PORT_MIN=20000
SOCKS_UDP_PORT_MAX=20031
# Set this to the Docker host LAN address only when clients use published ports.
SOCKS_UDP_ADVERTISE_IP=
